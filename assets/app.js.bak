  }

  function exportPolizasJson() {
    const data = buildPolizasNominaJson();
    if (!data) return;
    downloadText('polizas_nomina_por_periodo.json', JSON.stringify(data, null, 2), 'application/json;charset=utf-8;');
  }



  function exportDirectionEmployeesCsv() {
    const data = state.directionIndicators || buildDirectionIndicators();
    if (!data.employees.length) return;
    const rows = [
      ['Empleado', 'RFC', 'Numeros de empleado', 'Recibos', 'Percepciones', 'Deducciones', 'Neto'],
      ...data.employees.map((row) => [
        row.nombreEmpleado,
        row.rfcEmpleado,
        row.numerosEmpleado,
        row.recibos,
        row.percepciones,
        row.deducciones,
        row.neto
      ])
    ];
    downloadCsv('direccion_empleados_mayor_importe.csv', rows);
  }

  function exportDirectionConceptsCsv() {
    const data = state.directionIndicators || buildDirectionIndicators();
    if (!data.topConcepts.length) return;
    const rows = [
      ['Tipo', 'Clave', 'Concepto', 'Movimientos', 'Total'],
      ...data.topConcepts.map((row) => [
        TYPE_LABEL[row.tipoLinea] || row.tipoLinea,
        row.clave,
        row.concepto,
        row.count,
        row.total
      ])
    ];
    downloadCsv('direccion_conceptos_relevantes.csv', rows);
  }

  function exportDirectionMonthlyCsv() {
    const data = state.directionIndicators || buildDirectionIndicators();
    if (!data.monthlyPerceptions.length) return;
    const header = ['Empleado', 'RFC', ...data.monthlyColumns, 'Total'];
    const body = data.monthlyPerceptions.map((row) => [
      row.nombreEmpleado,
      row.rfcEmpleado,
      ...row.valores,
      row.total
    ]);
    const totals = ['Total general', '', ...data.monthlyTotals, data.grandTotalPerceptions];
    downloadCsv('direccion_percepciones_por_empleado_y_mes.csv', [header, ...body, totals]);
  }

  function exportDirectionDuplicatesCsv() {
    const data = state.directionIndicators || buildDirectionIndicators();
    if (!data.duplicateEmployees.length) return;
    const rows = [
      ['Empleado', 'RFC', 'Numeros de empleado', 'Periodo', 'Periodicidad', 'Recibos', 'Total nomina', 'UUIDs detectados'],
      ...data.duplicateEmployees.map((row) => {
        const period = state.periods.get(row.periodKey);
        return [
          row.nombreEmpleado,
          row.rfcEmpleado,
          row.numerosEmpleado,
          `${period?.fechaInicial || '---'} al ${period?.fechaFinal || '---'}`,
          describePeriodicidad(row.periodicidad),
          row.recibos.length,
          row.totalNomina,
          Array.from(row.uuids).join(' | ')
        ];
      })
    ];
    downloadCsv('direccion_duplicidades_por_periodo.csv', rows);
  }

  function buildDirectionIndicators() {
    const rows = state.visibleCfdiRows;
    const conceptSummary = state.visibleConceptSummary;
    const employeeMap = new Map();
    const duplicateGroups = new Map();
    const monthlyPerceptionsMap = new Map();
    const monthSet = new Set();

    rows.forEach((row) => {
      const employeeKey = row.rfcReceptor || `${row.nombreReceptor}|${row.numEmpleado}`;
      if (!employeeMap.has(employeeKey)) {
        employeeMap.set(employeeKey, {
          nombreEmpleado: row.nombreReceptor,
          rfcEmpleado: row.rfcReceptor,
          numerosEmpleado: new Set(),
          recibos: 0,
          percepciones: 0,
          deducciones: 0,
          otrosPagos: 0,
          neto: 0
        });
      }
      const employee = employeeMap.get(employeeKey);
      employee.recibos += 1;
      employee.percepciones += row.totalPercepciones;
      employee.deducciones += row.totalDeducciones;
      employee.otrosPagos += row.totalOtrosPagos;
      employee.neto += row.totalPercepciones - row.totalDeducciones + row.totalOtrosPagos;
      if (row.numEmpleado) employee.numerosEmpleado.add(row.numEmpleado);
      if ((!employee.nombreEmpleado || employee.nombreEmpleado.length < row.nombreReceptor.length) && row.nombreReceptor) {
        employee.nombreEmpleado = row.nombreReceptor;
      }

      const duplicateKey = `${getPeriodKey(row)}|${row.rfcReceptor || row.nombreReceptor}`;
      if (!duplicateGroups.has(duplicateKey)) {
        duplicateGroups.set(duplicateKey, {
          nombreEmpleado: row.nombreReceptor,
          rfcEmpleado: row.rfcReceptor,
          numerosEmpleado: new Set(),
          periodKey: getPeriodKey(row),
          periodicidad: row.periodicidadPago,
          recibos: [],
          uuids: new Set(),
          totalNomina: 0
        });
      }
      const group = duplicateGroups.get(duplicateKey);
      group.recibos.push(row);
      if (row.uuid) group.uuids.add(row.uuid);
      if (row.numEmpleado) group.numerosEmpleado.add(row.numEmpleado);
      group.totalNomina += row.totalCfdi;

      const monthKey = (row.fechaPago || '').slice(0, 7) || 'Sin fecha';
      monthSet.add(monthKey);
      if (!monthlyPerceptionsMap.has(employeeKey)) {
        monthlyPerceptionsMap.set(employeeKey, {
          nombreEmpleado: row.nombreReceptor,
          rfcEmpleado: row.rfcReceptor,
          meses: new Map(),
          total: 0
        });
      }
      const monthlyEmployee = monthlyPerceptionsMap.get(employeeKey);
      if ((!monthlyEmployee.nombreEmpleado || monthlyEmployee.nombreEmpleado.length < row.nombreReceptor.length) && row.nombreReceptor) {
        monthlyEmployee.nombreEmpleado = row.nombreReceptor;
      }
      monthlyEmployee.meses.set(monthKey, (monthlyEmployee.meses.get(monthKey) || 0) + row.totalPercepciones);
      monthlyEmployee.total += row.totalPercepciones;
    });

    const employees = Array.from(employeeMap.values())
      .map((item) => ({
        ...item,
        numerosEmpleado: Array.from(item.numerosEmpleado).sort().join(' | ')
      }))
      .sort((a, b) => b.neto - a.neto)
      .slice(0, 10);

    const topConcepts = [...conceptSummary]
      .sort((a, b) => b.total - a.total)
      .slice(0, 10);

    const duplicateEmployees = Array.from(duplicateGroups.values())
      .filter((item) => item.recibos.length > 1 && item.uuids.size > 1)
      .map((item) => ({
        ...item,
        numerosEmpleado: Array.from(item.numerosEmpleado).sort().join(' | ')
      }))
      .sort((a, b) => b.recibos.length - a.recibos.length || b.totalNomina - a.totalNomina);

    const monthlyColumns = Array.from(monthSet).sort();
    const monthlyPerceptions = Array.from(monthlyPerceptionsMap.values())
      .map((item) => ({
        nombreEmpleado: item.nombreEmpleado,
        rfcEmpleado: item.rfcEmpleado,
        total: item.total,
        valores: monthlyColumns.map((month) => item.meses.get(month) || 0)
      }))
      .sort((a, b) => b.total - a.total || a.nombreEmpleado.localeCompare(b.nombreEmpleado, 'es'));

    const monthlyTotals = monthlyColumns.map((month, index) => monthlyPerceptions.reduce((acc, row) => acc + (row.valores[index] || 0), 0));
    const grandTotalPerceptions = monthlyTotals.reduce((acc, value) => acc + value, 0);

    const totalNomina = sumBy(rows, (row) => row.totalCfdi);
    const totalDeducciones = sumBy(rows, (row) => row.totalDeducciones);
    const employeeCount = employeeMap.size;
    const promedioEmpleado = employeeCount ? totalNomina / employeeCount : 0;
    const porcentajeDeducciones = totalNomina ? (totalDeducciones / totalNomina) * 100 : 0;
    const periodoMasCostoso = [...state.periods.values()]
      .map((period) => ({
        ...period,
        total: sumBy(rows.filter((row) => getPeriodKey(row) === period.key), (row) => row.totalCfdi)
      }))
      .sort((a, b) => b.total - a.total)[0] || null;

    return {
      totalNomina,
      promedioEmpleado,
      porcentajeDeducciones,
      employees,
      topConcepts,
      duplicateEmployees,
      monthlyPerceptions,
      monthlyColumns,
      monthlyTotals,
      grandTotalPerceptions,
      alerts: [
        {
          tone: state.duplicateFilesSkipped ? 'danger' : 'success',
          label: 'Recibos duplicados omitidos en carga',
          value: formatInteger(state.duplicateFilesSkipped),
          helper: state.duplicateFilesSkipped ? 'Se detectaron archivos ya incorporados y no se duplicaron en el tablero.' : 'Sin duplicados exactos durante la carga actual.'
        },
        {
          tone: duplicateEmployees.length ? 'warning' : 'success',
          label: 'Empleados con más de un recibo en el mismo periodo',
          value: formatInteger(duplicateEmployees.length),
          helper: duplicateEmployees.length ? 'Conviene validar ajustes, finiquitos, complementos o incidencias capturadas por separado.' : 'No se detectan casos repetidos por empleado y periodo.'
        },
        {
          tone: periodoMasCostoso ? 'warning' : 'success',
          label: 'Periodo con mayor costo de nómina',
          value: periodoMasCostoso ? formatMoney(periodoMasCostoso.total) : '0.00',
          helper: periodoMasCostoso ? `${periodoMasCostoso.fechaInicial || '---'} al ${periodoMasCostoso.fechaFinal || '---'} • ${describePeriodicidad(periodoMasCostoso.periodicidad)}` : 'Sin información suficiente para comparar periodos.'
        },
        {
          tone: porcentajeDeducciones > 20 ? 'warning' : 'success',
          label: 'Presión de deducciones sobre nómina',
          value: `${roundMoney(porcentajeDeducciones).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%`,
          helper: porcentajeDeducciones > 20 ? 'Revisa si hay descuentos extraordinarios, ISR elevado o ajustes acumulados.' : 'La carga de deducciones se mantiene en un rango operativo normal.'
        }
      ]
    };
  }

  function renderDirectionIndicators() {
    const data = state.directionIndicators || buildDirectionIndicators();
    els.dirTotalNomina.textContent = formatMoney(data.totalNomina);
    els.dirPromedioEmpleado.textContent = formatMoney(data.promedioEmpleado);
    els.dirPorcDeducciones.textContent = `${roundMoney(data.porcentajeDeducciones).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%`;
    els.dirDuplicadosOmitidos.textContent = formatInteger(state.duplicateFilesSkipped);

    renderDirectionAlerts(data.alerts);
    renderDirectionEmployees(data.employees);
    renderDirectionConcepts(data.topConcepts);
    renderDirectionMonthlyPerceptions(data.monthlyColumns, data.monthlyPerceptions, data.monthlyTotals, data.grandTotalPerceptions);
    renderDirectionDuplicates(data.duplicateEmployees);
  }

  function renderDirectionAlerts(alerts) {
    clearNode(els.directionAlerts);
    const fragment = document.createDocumentFragment();
    alerts.forEach((alert) => {
      const item = document.createElement('article');
      item.className = `alert-item alert-${alert.tone}`;
      const label = document.createElement('span');
      label.textContent = alert.label;
      const value = document.createElement('strong');
      value.textContent = alert.value;
      const helper = document.createElement('small');
      helper.textContent = alert.helper;
      item.append(label, value, helper);
      fragment.appendChild(item);
    });
    els.directionAlerts.appendChild(fragment);
  }

  function renderDirectionEmployees(rows) {
    clearNode(els.directionEmployeesBody);
    if (!rows.length) {
      els.directionEmployeesBody.appendChild(buildEmptyRow(7, 'Sin información disponible con los filtros actuales.'));
      return;
    }
    const fragment = document.createDocumentFragment();
    rows.forEach((row) => {
      fragment.appendChild(buildTableRow([
        row.nombreEmpleado,
        row.rfcEmpleado,
        row.numerosEmpleado,
        formatInteger(row.recibos),
        formatMoney(row.percepciones),
        formatMoney(row.deducciones),
        formatMoney(row.neto)
      ]));
    });
    els.directionEmployeesBody.appendChild(fragment);
  }

  function renderDirectionConcepts(rows) {
    clearNode(els.directionConceptsBody);
    if (!rows.length) {
      els.directionConceptsBody.appendChild(buildEmptyRow(5, 'Sin conceptos visibles para resumir.'));
      return;
    }
    const fragment = document.createDocumentFragment();
    rows.forEach((row) => {
      fragment.appendChild(buildTableRow([
        TYPE_LABEL[row.tipoLinea] || row.tipoLinea,
        row.clave,
        row.concepto,
        formatInteger(row.count),
        formatMoney(row.total)
      ]));
    });
    els.directionConceptsBody.appendChild(fragment);
  }

  function renderDirectionMonthlyPerceptions(columns, rows, totals, grandTotal) {
    clearNode(els.directionMonthlyHead);
    clearNode(els.directionMonthlyBody);
    clearNode(els.directionMonthlyFoot);

    const headRow = document.createElement('tr');
    ['Empleado', 'RFC', ...columns, 'Total'].forEach((label) => {
      const th = document.createElement('th');
      th.textContent = label === 'Sin fecha' ? 'Sin fecha' : label;
      headRow.appendChild(th);
    });
    els.directionMonthlyHead.appendChild(headRow);

    if (!rows.length) {
      els.directionMonthlyBody.appendChild(buildEmptyRow(columns.length + 3, 'Aún no hay percepciones suficientes para construir el comparativo mensual.'));
      return;
    }

    const fragment = document.createDocumentFragment();
    rows.forEach((row) => {
      fragment.appendChild(buildTableRow([
        row.nombreEmpleado,
        row.rfcEmpleado,
        ...row.valores.map((value) => formatMoney(value)),
        formatMoney(row.total)
      ]));
    });
    els.directionMonthlyBody.appendChild(fragment);

    const footRow = document.createElement('tr');
    footRow.className = 'totals-row';
    ['Total general', '', ...totals.map((value) => formatMoney(value)), formatMoney(grandTotal)].forEach((value, index) => {
      const cell = document.createElement(index < 2 ? 'th' : 'td');
      cell.textContent = value;
      footRow.appendChild(cell);
    });
    els.directionMonthlyFoot.appendChild(footRow);
  }

  function renderDirectionDuplicates(rows) {
    clearNode(els.directionDuplicatesBody);
    if (!rows.length) {
      els.directionDuplicatesBody.appendChild(buildEmptyRow(8, 'No se detectaron empleados con más de un recibo distinto en el mismo periodo.'));
      return;
    }
    const fragment = document.createDocumentFragment();
    rows.forEach((row) => {
      const period = state.periods.get(row.periodKey);
      fragment.appendChild(buildTableRow([
        row.nombreEmpleado,
        row.rfcEmpleado,
        row.numerosEmpleado,
        `${period?.fechaInicial || '---'} al ${period?.fechaFinal || '---'}`,
        describePeriodicidad(row.periodicidad),
        formatInteger(row.recibos.length),
        formatMoney(row.totalNomina),
        Array.from(row.uuids).join(' | ')
      ]));
    });
    els.directionDuplicatesBody.appendChild(fragment);
  }

  function buildEmptyRow(colspan, text) {
    const tr = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = colspan;
    td.className = 'empty-state';
    td.textContent = text;
    tr.appendChild(td);
    return tr;
  }

  function buildDuplicateKey(cfdiRow, xmlText) {
    if (cfdiRow.uuid) return `uuid:${cfdiRow.uuid}`;
    return `fallback:${simpleHash([
      cfdiRow.rfcEmisor,
      cfdiRow.rfcReceptor,
      cfdiRow.numEmpleado,
      cfdiRow.fechaPago,
      cfdiRow.fechaInicial,
      cfdiRow.fechaFinal,
      cfdiRow.totalCfdi,
      normalizeSearch(xmlText)
    ].join('|'))}`;
  }

  function simpleHash(text) {
    let hash = 0;
    for (let index = 0; index < text.length; index += 1) {
      hash = ((hash << 5) - hash) + text.charCodeAt(index);
      hash |= 0;
    }
    return String(hash >>> 0);
  }

  function buildPeriodSelectionCard(period) {
    const card = document.createElement('div');
    card.className = 'selection-item';

    const label = document.createElement('label');
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.checked = Boolean(state.periodSelection.get(period.key));
    checkbox.addEventListener('change', () => {
      state.periodSelection.set(period.key, checkbox.checked);
      updateAll();
    });

    const main = document.createElement('div');
    main.className = 'selection-main';

    const title = document.createElement('strong');
    title.textContent = `${period.fechaInicial || '---'} al ${period.fechaFinal || '---'}`;

    const desc = document.createElement('span');
    desc.className = 'muted small-text';
    desc.textContent = `${describePeriodicidad(period.periodicidad)} • ${formatInteger(period.count)} CFDI`;

    main.appendChild(title);
    main.appendChild(desc);
    label.appendChild(checkbox);
    label.appendChild(main);
    card.appendChild(label);
    return card;
  }

  function buildConceptSelectionCard(key, meta) {
    const card = document.createElement('div');
    card.className = 'selection-item';

    const label = document.createElement('label');
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.checked = Boolean(state.conceptSelection.get(key));
    checkbox.addEventListener('change', () => {
      state.conceptSelection.set(key, checkbox.checked);
      updateAll();
    });

    const main = document.createElement('div');
    main.className = 'selection-main';

    const title = document.createElement('strong');
    title.textContent = `${meta.clave || 'Sin clave'} · ${meta.concepto || 'Sin concepto'}`;

    const badges = document.createElement('div');
    badges.className = 'badges';
    badges.appendChild(buildBadge(TYPE_LABEL[meta.tipoLinea] || meta.tipoLinea, getBadgeClass(meta.tipoLinea)));
    badges.appendChild(buildBadge(`SAT ${meta.tipoSat || '—'}`, 'badge-gray'));
    if (isEssentialConcept(meta.tipoLinea, meta.clave, meta.concepto)) {
      badges.appendChild(buildBadge('Indispensable', 'badge-green'));
    }

    main.appendChild(title);
    main.appendChild(badges);
    label.appendChild(checkbox);
    label.appendChild(main);
    card.appendChild(label);
    return card;
  }

  function buildBadge(text, className) {
    const span = document.createElement('span');
    span.className = `badge ${className}`;
    span.textContent = text;
    return span;
  }

  function buildTableRow(values) {
    const tr = document.createElement('tr');
    values.forEach((value) => {
      const td = document.createElement('td');
      td.textContent = String(value ?? '');
      tr.appendChild(td);
    });
    return tr;
  }

  function setActiveTab(tabName) {
    els.tabButtons.forEach((button) => button.classList.toggle('active', button.dataset.tab === tabName));
    els.tabPanels.forEach((panel) => panel.classList.toggle('active', panel.dataset.tabPanel === tabName));
  }

  function setStatus(text) {
    els.status.textContent = text;
  }

  function toggleExportButton(button, enabled) {
    button.disabled = !enabled;
  }

  function clearNode(node) {
    while (node.firstChild) node.removeChild(node.firstChild);
  }

  function findFirstByLocalName(root, localName) {
    if (!root) return null;
    const byNs = root.getElementsByTagNameNS('*', localName);
    if (byNs && byNs.length) return byNs[0];
    const all = root.getElementsByTagName('*');
    for (let index = 0; index < all.length; index += 1) {
      if (all[index].localName === localName) return all[index];
    }
    return null;
  }

  function findChildByLocalName(root, localName) {
    if (!root) return null;
    const children = root.children || [];
    for (let index = 0; index < children.length; index += 1) {
      if (children[index].localName === localName) return children[index];
    }
    return null;
  }

  function forEachByLocalName(root, localName, callback) {
    const nodes = root.getElementsByTagNameNS('*', localName);
    for (let index = 0; index < nodes.length; index += 1) callback(nodes[index], index);
  }

  function getAttr(node, attrName) {
    return node && node.getAttribute(attrName) ? node.getAttribute(attrName) : '';
  }

  function normalizeDateOnly(value) {
    if (!value) return '';
    return String(value).slice(0, 10);
  }

  function toNumber(value) {
    if (value === null || value === undefined || value === '') return 0;
    const normalized = String(value).replace(/,/g, '');
    const parsed = Number.parseFloat(normalized);
    return Number.isFinite(parsed) ? parsed : 0;
  }

  function roundMoney(value) {
    return Number.parseFloat((value || 0).toFixed(2));
  }

  function formatMoney(value) {
    return roundMoney(value).toLocaleString('es-MX', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function formatInteger(value) {
    return Number(value || 0).toLocaleString('es-MX');
  }

  function normalizeSearch(value) {
    return String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  function describePeriodicidad(code) {
    return PERIODICITY_MAP[code] || code || '';
  }

  function getPeriodKey(row) {
    return [row.fechaInicial || '', row.fechaFinal || '', row.periodicidadPago || ''].join('|');
  }

  function getConceptKey(row) {
    return [row.tipoLinea || '', row.tipoSat || '', row.clave || '', row.concepto || ''].join('|');
  }

  function isEssentialConcept(tipoLinea, clave, concepto) {
    const normalizedClave = String(clave || '').trim();
    const lowerConcept = normalizeSearch(concepto);

    if (tipoLinea === 'P' && ESSENTIAL_PER.has(normalizedClave)) return true;
    if (tipoLinea === 'D' && ESSENTIAL_DED.has(normalizedClave)) return true;
    if (tipoLinea === 'O' && ESSENTIAL_OTH.has(normalizedClave)) return true;

    return [
      'sueldo',
      'salario',
      'isr',
      'imss',
      'seguridad social',
      'subsidio'
    ].some((keyword) => lowerConcept.includes(keyword));
  }

  function getBadgeClass(tipoLinea) {
    if (tipoLinea === 'P') return 'badge-blue';
    if (tipoLinea === 'D') return 'badge-red';
    return 'badge-green';
  }

  function comparePeriods(a, b) {
    if (!a && !b) return 0;
    if (!a) return 1;
    if (!b) return -1;
    return (
      String(a.fechaInicial || '').localeCompare(String(b.fechaInicial || '')) ||
      String(a.fechaFinal || '').localeCompare(String(b.fechaFinal || '')) ||
      String(a.periodicidad || '').localeCompare(String(b.periodicidad || ''))
    );
  }

  function compareConceptMeta(a, b) {
    return (
      String(a.tipoLinea || '').localeCompare(String(b.tipoLinea || '')) ||
      String(a.tipoSat || '').localeCompare(String(b.tipoSat || '')) ||
      String(a.clave || '').localeCompare(String(b.clave || '')) ||
      String(a.concepto || '').localeCompare(String(b.concepto || ''))
    );
  }

  function sumBy(collection, getter) {
    return collection.reduce((acc, item) => acc + toNumber(getter(item)), 0);
  }

  function findCfdiByPeriodAndEmployee(periodKey, rfcEmpleado, numEmpleado, fechaPago) {
    return state.cfdis.find((row) => {
      return getPeriodKey(row) === periodKey && row.rfcReceptor === rfcEmpleado && row.numEmpleado === numEmpleado && row.fechaPago === fechaPago;
    }) || null;
  }

function escapeCsv(value) {
  const text = String(value ?? '').normalize("NFC"); // 🔹 Normaliza acentos y caracteres
  if (/[",\r\n]/.test(text)) return `"${text.replace(/"/g, '""')}"`;
  return text;
}


  function downloadCsv(fileName, rows) {
    const content = rows.map((row) => row.map(escapeCsv).join(',')).join('\r\n');
    downloadText(fileName, content, 'text/csv;charset=utf-8;');
  }

  function downloadText(fileName, content, mimeType) {
  const blob = new Blob([new TextEncoder("utf-8").encode(content)], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

})();
