        row.gravado,
        row.exento,
        row.total,
        row.uuid
      ])
    ];
    downloadCsv('nomina_movimientos_concepto.csv', rows);
  }

  function exportConceptSummaryCsv() {
    if (!state.visibleConceptSummary.length) return;
    const rows = [
      ['Tipo', 'Tipo SAT', 'Clave', 'Concepto', 'Importe gravado', 'Importe exento', 'Importe deducciones', 'Importe total', 'Movimientos'],
      ...state.visibleConceptSummary.map((item) => [
        TYPE_LABEL[item.tipoLinea] || item.tipoLinea,
        item.tipoSat,
        item.clave,
        item.concepto,
        item.gravado,
