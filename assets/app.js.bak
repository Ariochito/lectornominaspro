  }

  function exportConceptPeriodSummaryCsv() {
    if (!state.visiblePeriodSummary.length) return;
    const rows = [
      ['Periodo', 'Periodicidad', 'Tipo', 'Tipo SAT', 'Clave', 'Concepto', 'Importe gravado', 'Importe exento', 'Importe deducciones', 'Importe total', 'Movimientos'],
      ...state.visiblePeriodSummary.map((item) => {
        const periodMeta = state.periods.get(item.periodKey);
        return [
          `${periodMeta?.fechaInicial || '---'} al ${periodMeta?.fechaFinal || '---'}`,
          describePeriodicidad(periodMeta?.periodicidad || ''),
          TYPE_LABEL[item.tipoLinea] || item.tipoLinea,
          item.tipoSat,
          item.clave,
          item.concepto,
          item.gravado,
          item.exento,
          item.deducciones,
          item.total,
          item.count
        ];
      })
